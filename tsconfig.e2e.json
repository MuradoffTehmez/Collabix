{
  // E2E dəsti üçün AYRICA konfiqurasiya — AUDIT-TASK-6 §A-1.
  //
  // Niyə ayrı fayl (əsas `tsconfig.json`-a əlavə etmək əvəzinə):
  //   * e2e kodu `page.evaluate` daxilində BRAUZER API-lərini işlədir
  //     (`window`, `document`, `localStorage`) → `DOM` lib tələb olunur;
  //   * worker kodu isə Workers runtime tiplərini işlədir və `DOM`-suzdur.
  //   * Bəzi spec-lər `../worker/*`-dan import edir (məs. `rate-limit.spec.ts`
  //     → `RL`), ona görə burada HƏR İKİ tip dəsti yüklənir. Qlobal
  //     toqquşmalar `skipLibCheck` ilə susdurulur — bu, YALNIZ .d.ts
  //     fayllarına aiddir, öz kodumuz tam yoxlanılır.
  //
  // Səbəb (AUDIT-TASK-5 §10/1): `tsconfig.json` yalnız `worker/**/*.ts`-i
  // əhatə edirdi, yəni `tsc --noEmit` e2e/ qovluğunu HEÇ VAXT yoxlamırdı.
  // Nəticədə `e2e/audit-lib.ts`-də çatışmayan bir `import` typecheck-dən keçdi
  // və BÜTÜN dəstin yüklənməsini sındırdı — səhv yalnız Playwright işə
  // salınanda göründü.
  //
  // İşə salmaq: `npm run typecheck` hər iki konfiqurasiyanı qaçırır.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@cloudflare/workers-types", "node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true
  },
  "include": ["e2e/**/*.ts"]
}
