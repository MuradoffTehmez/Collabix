{
  "name": "collabix",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Collabix — Cloudflare Workers + D1 + R2 + KV üzərində öyrənmə platforması",
  "scripts": {
    "build": "vite build",
    "dev": "npm run build && wrangler dev --persist-to .wrangler/state",
    "check:migrations": "node scripts/check-migrations.mjs",
    "predeploy": "node scripts/check-migrations.mjs --remote",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply collabix-db --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply collabix-db --remote",
    "e2e": "playwright test --grep-invert \"responsive audit hesabatı\"",
    "e2e:seed": "node e2e/seed-cli.ts",
    "e2e:ui": "playwright test --ui",
    "audit:responsive": "playwright test responsive-report --project=desktop"
  },
  "dependencies": {
    "dompurify": "^3.1.6",
    "highlight.js": "^11.10.0",
    "marked": "^12.0.2",
    "qrcode-generator": "^2.0.4",
    "workers-og": "^0.0.27"
  },
  "devDependencies": {
    "@cloudflare/puppeteer": "^1.1.0",
    "@cloudflare/workers-types": "^5.20260714.1",
    "@playwright/test": "^1.61.1",
    "simple-icons": "^16.27.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "wrangler": "^4.24.0"
  }
}
