{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "collabix",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  // Statik sayt (Vite build çıxışı). /assets/* (hashed, immutable JS/CSS) birbaşa
  // edge-dən verilir — Worker-i işə salmır (sürət + pulsuz kvota qənaəti).
  // Qalan HƏR ŞEY (HTML sənədi, /api/*, /files/*) Worker-dən keçir ki, security
  // header-lər (CSP daxil) əsl HTML cavabına da tətbiq olunsun.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/**", "!/assets/*"]
  },

  // D1 — əsas verilənlər bazası
  // İlk dəfə: `wrangler d1 create collabix-db` → database_id-ni bura yaz.
  // Lokal dev üçün placeholder kifayətdir (lokal SQLite işlədilir).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "collabix-db",
      "database_id": "eb30cafe-d189-42d3-aed5-320eafe5c188"
    }
  ],

  // R2 — fayl anbarı (avatar, post şəkilləri, mesaj faylları)
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "collabix-files" }
  ],

  // KV — sessiyalar + rate-limit + kiçik keş
  // İlk dəfə: `wrangler kv namespace create SESSIONS` → id-ni bura yaz.
  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "c631f38c595440de8431bc93d00cb548" }
  ],

  "vars": {
    "ENVIRONMENT": "production",

    // Transactional e-poçtun GÖNDƏRƏN ünvanı.
    //
    // ⚠ BU DƏYƏR OLMADAN bütün e-poçt axını SÖNÜR: `emailEnabled()` false
    //   qaytarır → `publicConfig.magicLink` false olur → "Şifrəni unutmusan?"
    //   modalı ümumiyyətlə açılmır. Qüsur səssizdir, ona görə burada qeyd
    //   olunur.
    //
    // 🔴 `onboarding@resend.dev` RESEND-in TEST GÖNDƏRİCİSİDİR:
    //    məktub YALNIZ Resend hesabının öz təsdiqlənmiş ünvanına çatır.
    //    Real istifadəçilərə göndərmək üçün Resend-də domen təsdiqlənməli və
    //    bu sətir həmin domendəki ünvana dəyişdirilməlidir
    //    (məsələn "no-reply@collabix.az").
    //
    // ⚠ API açarı BURADA DEYİL — sirrdir:
    //      wrangler secret put RESEND_API_KEY
    "EMAIL_FROM": "onboarding@resend.dev",
    "APP_NAME": "Collabix",

    // Saytın KANONİK origin-i — domenin TƏK HƏQİQƏT MƏNBƏYİ
    // (AUDIT-TASK-2 / struktur borcu #14).
    //
    // Buradan oxunur: canonical URL, hreflang alternatları, sitemap.xml,
    // robots.txt, llms.txt, JSON-LD (`url`/`logo`), OG şəkil URL-ləri və
    // komanda dəvət emaillərindəki link.
    //
    // ⚠ DƏYƏR HAZIRDA FAKTİKİ CANLI DOMENDİR. Rəsmi domen (collabix.az)
    // AUDIT-TASK-2 anında DNS-də QEYDİYYATDA DEYİL (NXDOMAIN) — ona keçid
    // burada bir sətir dəyişməklə OLMAZ, əvvəlcə DNS + Cloudflare custom
    // domain + köhnə URL-lərdən 301 yönləndirmə planı lazımdır. Əks halda
    // bütün canonical/sitemap URL-ləri mövcud olmayan domenə işarə edər və
    // indeksləmə çökər.
    "SITE_ORIGIN": "https://collabix.muradofftehmez01.workers.dev",

    // Dəvət emailindəki linkin bazası. Əvvəl bu var HEÇ TƏYİN OLUNMAMIŞDI və
    // `worker/jobs/team.ts` `https://collabix.site` fallback-ına düşürdü —
    // həmin domen DNS-də mövcud deyil, yəni göndərilən BÜTÜN komanda dəvət
    // emailləri ölü linklə gedirdi (AUDIT-TASK-2-də aşkarlandı).
    "APP_URL": "https://collabix.muradofftehmez01.workers.dev",

    // Turnstile PUBLIC site key (TASK-8 / Bənd 7). Secret DEYİL — brauzerə
    // onsuz da göndərilir, ona görə burada saxlanması təhlükəsizdir.
    // Cütü olan gizli açar `wrangler secret put TURNSTILE_SECRET` ilə qoyulur.
    // BOŞ QALDIQDA bot qoruması tamamilə söndürülür və sayt normal işləyir
    // (bax docs/TASK-8-SETUP.md → "Turnstile").
    "TURNSTILE_SITE_KEY": "0x4AAAAAAD6qIZOaina_as3U",

    // Arxivləmə "isti pəncərəsi": 90 gündən köhnə otaq/DM mesajları gündəlik
    // cron ilə R2-yə köçürülür və D1-dən silinir.
    //
    // OXU YOLU (AUDIT-TASK-8 / C-3): mesajlar İTMİR —
    //   GET /api/rooms/:id/messages?before=<ts>
    //   GET /api/dms/:pair/messages?before=<ts>
    // D1 bitəndə server ARXİVƏ keçir (`worker/archive.ts` → `readArchive`),
    // UI-da "Daha köhnə mesajlar" düyməsi bunu çağırır, GDPR ixracı da
    // arxivlənmiş mesajları əhatə edir.
    //
    // ⚠️ TASK 7 SƏRHƏDİ: arxiv SERVER TƏRƏFDƏ oxunur; `/files/archive/…`
    // `canReadKey`-də admin ilə bağlı qalır və AÇILMAMALIDIR.
    //
    // ⚠️ Dəyəri ARTIRMAQ D1 storage xərcini artırır; AZALTMAQ isə istifadəçi
    // üçün "daha köhnə" yükləmələrini bahalaşdırır (hər səhifə R2 sorğusu +
    // gzip açılması — ölçmə: tipik 4,4 ms, ən pis 54,6 ms CPU, bax
    // AUDIT-TASK-8-REPORT.md §2).
    "ARCHIVE_HOT_DAYS": "90"
  },

  // ════════════════════════════════════════════════════════════════════════
  // STAGING — AUDIT-TASK-10 / Faza 1.7 (audit proses borcu #10)
  // ════════════════════════════════════════════════════════════════════════
  //
  // Audit: "`wrangler.jsonc`-da `env.*` bölməsi yoxdur; deploy BİRBAŞA
  // istehsala." Yəni miqrasiya sırası, sxem dəyişikliyi və yeni kod ilk dəfə
  // CANLI istifadəçilərin üzərində sınanırdı.
  //
  // ⚠ Task 8 §7.b-dəki gizli Critical qüsur (`IN (?×2000)` D1 limitini aşırdı)
  //   staging-də TUTULARDI — orada real həcmli data ilə cron bir dəfə işləyərdi.
  //
  // 🔴 QURULMA ADDIMLARI (icra agenti bunları edə BİLMƏZ — hesab sahibi lazımdır):
  //     wrangler d1 create collabix-db-staging
  //     wrangler r2 bucket create collabix-files-staging
  //     wrangler kv namespace create SESSIONS_STAGING
  //   Sonra aşağıdakı `PLACEHOLDER` dəyərləri əsl id-lərlə əvəz olunur.
  //   Bu, `docs/TASK-10-SCOPE.md` §5-də xarici öhdəlik kimi qeyd olunub.
  //
  // ⚠ Bu blok YALNIZ `--env staging` ilə oxunur; adi `wrangler dev`/`deploy`
  //   ona toxunmur, ona görə placeholder-lər istehsalı bloklamır.
  //
  // İstifadə:  npx wrangler deploy --env staging
  //            npx wrangler d1 migrations apply collabix-db-staging --remote --env staging
  "env": {
    "staging": {
      "name": "collabix-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        // ⚠ Staging ÖZ origin-ini daşımalıdır: Task 2-nin `SITE_ORIGIN` tək
        //   mənbəsi canonical URL, sitemap və OG şəkillərini idarə edir —
        //   istehsal domenini işlətsək staging kontenti indeksləmə üçün
        //   istehsal URL-lərini elan edərdi.
        "SITE_ORIGIN": "https://collabix-staging.muradofftehmez01.workers.dev",
        "APP_URL": "https://collabix-staging.muradofftehmez01.workers.dev",
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "ARCHIVE_HOT_DAYS": "90"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "collabix-db-staging", "database_id": "PLACEHOLDER-STAGING-D1-ID" }
      ],
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "collabix-files-staging" }
      ],
      "kv_namespaces": [
        { "binding": "SESSIONS", "id": "PLACEHOLDER-STAGING-KV-ID" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "ROOM_DO", "class_name": "RoomDO" },
          { "name": "PRESENCE_DO", "class_name": "PresenceDO" },
          { "name": "RATE_LIMIT_DO", "class_name": "RateLimitDO" }
        ]
      },
      "observability": { "enabled": true }
    }
  },

  // 🔴 AUDIT-TASK-10 / Faza 2.1 — ANA AÇAR `false` idi.
  //
  // Alt açarlar (`logs.enabled`, `traces.enabled`) `true` olsa da ana açar
  // sönülü olduğu üçün HEÇ NƏ toplanmırdı. Bu bir sətir Task 1–9-un bütün
  // ölçmə öhdəliklərini mümkün edir:
  //   • Task 4  — istehsalda p50/p95 (rate limit səbətləri ölçmədən çıxıb)
  //   • Task 7  — `/files/` gecikməsi prefiks üzrə
  //   • Task 9  — DO gecikməsi (lokal ölçmədə şəbəkə round-trip-i YOXDUR,
  //               ona görə istehsal rəqəmi başqa ola bilər)
  //   • Task 9  — XP tavanlarının real trafiklə yenidən qiymətləndirilməsi
  //
  // ⚠ `head_sampling_rate: 1` = 100% sampling. Trafik böyüyəndə bu, xərcə
  //   çevrilir; Task 4 §5.2 `read` səbəti üçün sampling təklif etmişdi —
  //   həmin qərar məhz BU ölçmələrdən sonra verilməlidir.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },

  // Cloudflare Queues (TASK-8 / Bənd 18) — asinxron fan-out.
  // Eyni Worker həm producer, həm consumer-dir (ayrıca Worker lazım deyil).
  //
  // İlk dəfə: `wrangler queues create collabix-tasks` və `... collabix-tasks-dlq`.
  //
  // `max_retries` + `dead_letter_queue`: təkrar-təkrar sınan mesaj sonsuz
  // dövrə girməməlidir — 3 cəhddən sonra DLQ-ya düşür və orada araşdırılır.
  // DLQ olmasaydı belə mesaj ya itərdi, ya da növbəni tıxayardı.
  "queues": {
    "producers": [
      { "queue": "collabix-tasks", "binding": "TASKS" }
    ],
    "consumers": [
      {
        "queue": "collabix-tasks",
        // Kiçik partiya + qısa gözləmə: bildiriş gecikməsi hiss olunmasın.
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "collabix-tasks-dlq"
      }
    ]
  },

  // Cron Trigger (TASK-8 / Bənd 12) — gündəlik arxivləmə + təmizləmə.
  // 03:17 UTC: "yuvarlaq" saatlar Cloudflare-də ən sıx cron pəncərəsidir,
  // qeyri-adi dəqiqə seçmək növbədə gözləməni azaldır.
  // İş: köhnə mesajları R2-yə köçür, vaxtı bitmiş sessiyaları və 90 gündən
  // köhnə təhlükəsizlik hadisələrini sil (worker/archive.ts → runArchiveJob).
  "triggers": {
    "crons": ["17 3 * * *"]
  },

  // Realtime Durable Object-lar: hər otağa RoomDO (mesaj+typing), qlobal PresenceDO (online/offline).
  "durable_objects": {
    "bindings": [
      { "name": "ROOM_DO", "class_name": "RoomDO" },
      { "name": "PRESENCE_DO", "class_name": "PresenceDO" },
      // ATOMİK rate limiter (AUDIT-TASK-9 / H-3). Hər limit açarına AYRICA
      // instans (`idFromName('rl:auth:i:<ip>')`) — DO tək-axınlı olduğu üçün
      // `get`→`put` yarışsızdır. Native `ratelimit` binding-i seçilmədi:
      // o, PoP BAŞINA sayır və sənəddə "not an accurate accounting system"
      // kimi təsvir olunur (əsaslandırma: worker/rate-limit-do.ts başlığı).
      { "name": "RATE_LIMIT_DO", "class_name": "RateLimitDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO"] },
    { "tag": "v2", "new_sqlite_classes": ["PresenceDO"] },
    { "tag": "v3", "new_sqlite_classes": ["RateLimitDO"] }
  ],
  
  "workflows": [
    {
      "name": "collabix-workflow",
      "binding": "WORKFLOW",
      "class_name": "CollabixWorkflow"
    }
  ],
  
  "ai": {
    "binding": "AI"
  },
  
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "collabix-index"
    }
  ],
  
  "browser": {
    "binding": "BROWSER"
  }

  // Secrets (repo-da SAXLANILMIR — CLI ilə):
  //   wrangler secret put JWT_SECRET        ← uzun təsadüfi sətir (məs. `openssl rand -base64 48`)
  //   wrangler secret put TURNSTILE_SECRET  ← Turnstile gizli açarı (opsional, Bənd 7)
  // Lokal dev üçün: .dev.vars faylı (gitignore-dadır)
}
